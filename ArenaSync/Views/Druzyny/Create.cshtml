@model Druzyna
@{ ViewData["Title"] = User.IsInRole(Role.Admin) ? "Nowa drużyna" : "Zgłoszenie drużyny"; }

<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-accent">@(User.IsInRole(Role.Admin) ? "Zapisz" : "Wyślij zgłoszenie")</button>
            <a asp-action="Index" class="btn btn-outline-light">Anuluj</a>
        </div>
    </form>
</div></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
