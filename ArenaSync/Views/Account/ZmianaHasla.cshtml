@model ZmianaHaslaViewModel
@{ ViewData["Title"] = "Zmiana hasła"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Zmiana hasła</h1>
        <div class="card"><div class="card-body">
            <form asp-action="ZmianaHasla" method="post">
                <div asp-validation-summary="ModelOnly" class="mb-2" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="ObecneHaslo" class="form-label"></label>
                    <input asp-for="ObecneHaslo" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="ObecneHaslo" class="small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NoweHaslo" class="form-label"></label>
                    <input asp-for="NoweHaslo" class="form-control" autocomplete="new-password" aria-describedby="wymagania-NoweHaslo" />
                    <partial name="_WymaganiaHasla" model='"NoweHaslo"' />
                    <span asp-validation-for="NoweHaslo" class="small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PowtorzHaslo" class="form-label"></label>
                    <input asp-for="PowtorzHaslo" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="PowtorzHaslo" class="small"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-accent">Zmień hasło</button>
                    <a asp-action="Ustawienia" class="btn btn-outline-light">Anuluj</a>
                </div>
            </form>
        </div></div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
