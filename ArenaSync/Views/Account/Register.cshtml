@model RegisterViewModel
@{ ViewData["Title"] = "Rejestracja"; }

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Załóż konto</h1>
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="mb-2" role="alert"></div>

                    <fieldset class="mb-3">
                        <legend class="form-label fs-6 fw-medium">Rodzaj konta</legend>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="Rola" value="Zawodnik" id="rolaZawodnik" aria-describedby="rolaZawodnikOpis" />
                            <label class="form-check-label" for="rolaZawodnik">Zawodnik (członek drużyny)</label>
                            <div class="form-text" id="rolaZawodnikOpis">Przeglądasz terminarz, wyniki i skład swojej drużyny.</div>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="radio" asp-for="Rola" value="Kapitan" id="rolaKapitan" aria-describedby="rolaKapitanOpis" />
                            <label class="form-check-label" for="rolaKapitan">Kapitan drużyny</label>
                            <div class="form-text" id="rolaKapitanOpis">Zgłaszasz drużynę i zarządzasz jej kadrą.</div>
                        </div>
                        <span asp-validation-for="Rola" class="small"></span>
                    </fieldset>

                    <div class="mb-3" id="poleDruzyna">
                        <label asp-for="DruzynaId" class="form-label"></label>
                        <select asp-for="DruzynaId" asp-items="(IEnumerable<SelectListItem>)ViewBag.DruzynaId" class="form-select">
                            <option value="">-- wybierz drużynę --</option>
                        </select>
                        <span asp-validation-for="DruzynaId" class="small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ImieNazwisko" class="form-label"></label>
                        <input asp-for="ImieNazwisko" class="form-control" autocomplete="name" />
                        <span asp-validation-for="ImieNazwisko" class="small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" />
                        <span asp-validation-for="Email" class="small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Haslo" class="form-label"></label>
                        <input asp-for="Haslo" class="form-control" autocomplete="new-password" aria-describedby="wymagania-Haslo" />
                        <partial name="_WymaganiaHasla" model='"Haslo"' />
                        <span asp-validation-for="Haslo" class="small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PowtorzHaslo" class="form-label"></label>
                        <input asp-for="PowtorzHaslo" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="PowtorzHaslo" class="small"></span>
                    </div>
                    <button type="submit" class="btn btn-accent w-100">Załóż konto</button>
                </form>
                <p class="mt-3 mb-0 small">Konto administratora nadaje istniejący administrator.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Wybór drużyny potrzebny tylko zawodnikowi
        (function () {
            var pole = document.getElementById('poleDruzyna');
            function odswiez() {
                var zawodnik = document.getElementById('rolaZawodnik').checked;
                pole.hidden = !zawodnik;
            }
            document.querySelectorAll('input[name="Rola"]').forEach(function (r) { r.addEventListener('change', odswiez); });
            odswiez();
        })();
    </script>
}
