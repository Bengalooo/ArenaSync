@model ErrorViewModel
@{ ViewData["Title"] = "Błąd"; }

<div class="text-center py-5">
    <h1 class="h3 text-danger">Wystąpił błąd</h1>
    <p class="text-body-secondary">Podczas przetwarzania żądania coś poszło nie tak.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-accent" asp-controller="Home" asp-action="Index">Wróć na stronę główną</a>
</div>
